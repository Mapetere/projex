{
    "name": "projex-cli",
    "version": "0.4.0",
    "description": "Automatically infer projects from GitHub and generate portfolio entries",
    "type": "module",
    "bin": {
        "projex": "./dist/cli.js"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {

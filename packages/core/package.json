{
    "name": "@projex/core",
    "version": "0.2.0",
    "description": "Core inference engine for Projex",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./events": {
            "types": "./dist/events/index.d.ts",
            "import": "./dist/events/index.js"
        },
        "./inference": {
            "types": "./dist/inference/index.d.ts",
            "import": "./dist/inference/index.js"
        },
        "./storage": {
            "types": "./dist/storage/index.d.ts",
            "import": "./dist/storage/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc -w",
        "test": "vitest run"
    },
    "dependencies": {
        "@octokit/rest": "^20.0.0",
        "zod": "^3.22.0"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "typescript": "^5.3.0",
        "vitest": "^1.2.0"
    }
}
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "@octokit/rest": "^20.0.0",
        "commander": "^11.1.0",
        "chalk": "^5.3.0",
        "ora": "^8.0.0",
        "inquirer": "^9.2.0",
        "zod": "^3.22.0"
    },
    "devDependencies": {
        "@types/inquirer": "^9.0.0",
        "@types/node": "^20.10.0",
        "tsx": "^4.7.0",
        "typescript": "^5.3.0"
